<?xml version='1.0' encoding='utf-8'?>
<widget id="com.faruk.msadvancedmobicare" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>MS ADVANCED MOBICARE</name>
    <description>MS ADVANCED MOBICARE application with PDF generation, file opening, and sharing support</description>
    <author email="support@example.com" href="">Faruk Gazi</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="content://*/*" />
    <allow-intent href="intent:*" />
    <allow-intent href="whatsapp:*" />
    <allow-intent href="com.google.android.apps.docs:*" />

    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="2000" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="300" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="splash.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#eef7ff" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <preference name="AllowInlineMediaPlayback" value="true" />

    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="icon.png" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/queries">
            <intent>
                <action android:name="android.intent.action.VIEW" />
                <data android:mimeType="application/pdf" />
            </intent>
            <intent>
                <action android:name="android.intent.action.SEND" />
                <data android:mimeType="application/pdf" />
            </intent>
            <package android:name="com.whatsapp" />
            <package android:name="com.whatsapp.w4b" />
            <package android:name="com.google.android.apps.docs" />
            <package android:name="com.adobe.reader" />
        </config-file>

        <resource-file src="res/drawable/logo.png" target="app/src/main/res/drawable/logo.png" />
        <resource-file src="res/drawable/splash_mixed_bg.xml" target="app/src/main/res/drawable/splash_mixed_bg.xml" />
        <resource-file src="res/anim/drop_from_top_above_center.xml" target="app/src/main/res/anim/drop_from_top_above_center.xml" />
        <resource-file src="res/layout/splash_screen.xml" target="app/src/main/res/layout/splash_screen.xml" />
    </platform>

    <plugin name="cordova-plugin-file" spec="^8.1.0" />
    <plugin name="cordova-plugin-file-opener2" spec="^4.0.0" />
    <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />
</widget>
